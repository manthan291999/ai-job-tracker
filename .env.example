# Set these in Vercel > Project > Settings > Environment Variables.
# Never put real credentials in this file or in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Connect a PRIVATE Vercel Blob store; Vercel supplies this token.
BLOB_READ_WRITE_TOKEN=
# Generate a long random value. Vercel sends it as Authorization: Bearer ...
CRON_SECRET=
